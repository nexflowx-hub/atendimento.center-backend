generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "crm", "channels", "ai", "flows", "automation", "smm", "signals", "integrations", "audit", "portfolio", "governance", "finops", "knowledge"]
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  kind      String   @default("internal")
  status    String   @default("active")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenants   Tenant[]

  @@map("organizations")
  @@schema("core")
}

model Tenant {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String?              @map("organization_id") @db.Uuid
  name                String
  slug                String               @unique
  product             String               @default("platform")
  status              String               @default("active")
  plan                String               @default("internal")
  locale              String               @default("pt-BR")
  timezone            String               @default("America/Sao_Paulo")
  chatwootAccountId   Int?                 @unique @map("chatwoot_account_id")
  evolutionInstance   String?              @unique @map("evolution_instance")
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users               TenantUser[]
  entitlements        Entitlement[]
  aiConfiguration     AiConfiguration?
  contacts            Contact[]
  contactIdentities   ContactIdentity[]
  relationshipStates  RelationshipState[]
  conversationMemories ConversationMemory[]
  conversationSummaries ConversationSummary[]
  openLoops           OpenLoop[]
  agentWorldStates    AgentWorldState[]
  agentRuns           AgentRun[]
  agentFollowups      AgentFollowup[]
  leads               Lead[]
  activities          CrmActivity[]
  appointmentRequests AppointmentRequest[]
  channelAccounts     ChannelAccount[]
  conversationRefs    ConversationRef[]
  agents              Agent[]
  agentBindings       AgentBinding[]
  flowDefinitions     FlowDefinition[]
  flowRuns            FlowRun[]
  automationWorkflows AutomationWorkflow[]
  automationRuns      AutomationRun[]
  smmOffers           SmmOffer[]
  smmOrders           SmmOrder[]
  signalSources       SignalSource[]
  signalJobs          SignalJob[]
  signalItems         SignalItem[]
  integrationConnections IntegrationConnection[]
  webhookEvents       WebhookEvent[]
  auditLogs           AuditLog[]

  @@map("tenants")
  @@schema("core")
}

model TenantUser {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  authUserId String   @map("auth_user_id") @db.Uuid
  role       String   @default("agent")
  active     Boolean  @default(true)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, authUserId])
  @@index([authUserId])
  @@map("memberships")
  @@schema("core")
}

model Entitlement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  capability String
  status     String   @default("active")
  limitValue Decimal? @map("limit_value")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capability])
  @@map("entitlements")
  @@schema("core")
}

model Contact {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  externalKey      String?           @map("external_key")
  name             String?
  email            String?
  phone            String?
  telegramUsername String?           @map("telegram_username")
  source           String?
  locale           String?
  adultStatus      String            @default("unknown") @map("adult_status")
  timezone         String?
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads            Lead[]
  activities       CrmActivity[]
  appointmentRequests AppointmentRequest[]
  conversationRefs ConversationRef[]
  identities       ContactIdentity[]
  relationshipStates RelationshipState[]
  memories         ConversationMemory[]
  conversationSummaries ConversationSummary[]
  openLoops        OpenLoop[]
  agentRuns        AgentRun[]
  followups        AgentFollowup[]
  flowRuns         FlowRun[]
  smmOrders        SmmOrder[]

  @@unique([tenantId, externalKey])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("contacts")
  @@schema("crm")
}

model Lead {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  contactId       String?       @map("contact_id") @db.Uuid
  source          String?
  status          String        @default("new")
  stage           String?
  score           Decimal?
  productCode     String?       @map("product_code")
  ownerAuthUserId String?       @map("owner_auth_user_id") @db.Uuid
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities      CrmActivity[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([contactId])
  @@map("leads")
  @@schema("crm")
}

model CrmActivity {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  contactId    String?  @map("contact_id") @db.Uuid
  leadId       String?  @map("lead_id") @db.Uuid
  activityType String   @map("activity_type")
  externalRef  String?  @map("external_ref")
  summary      String?
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@map("activities")
  @@schema("crm")
}

model AppointmentRequest {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  contactId       String?  @map("contact_id") @db.Uuid
  contactName     String?  @map("contact_name")
  contactPhone    String   @map("contact_phone")
  service         String?
  preferredDate   DateTime? @map("preferred_date") @db.Timestamptz(6)
  preferredPeriod String?  @map("preferred_period")
  status          String   @default("pending")
  conversationId  String?  @map("conversation_id")
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("appointment_requests")
  @@schema("crm")
}

model ChannelAccount {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  channelType       String            @map("channel_type")
  provider          String
  name              String
  externalAccountId String?           @map("external_account_id")
  status            String            @default("active")
  secretRef         String?           @map("secret_ref")
  settings          Json              @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationRefs  ConversationRef[]
  identities        ContactIdentity[]
  agentBindings     AgentBinding[]

  @@unique([tenantId, channelType, provider, externalAccountId])
  @@index([tenantId, channelType])
  @@map("accounts")
  @@schema("channels")
}

model ConversationRef {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  contactId              String?        @map("contact_id") @db.Uuid
  channelAccountId       String         @map("channel_account_id") @db.Uuid
  externalConversationId String         @map("external_conversation_id")
  externalInboxId        String?        @map("external_inbox_id")
  status                 String         @default("open")
  metadata               Json           @default("{}")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant                 Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact                Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channelAccount         ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  flowRuns               FlowRun[]
  summaries              ConversationSummary[]
  agentRuns              AgentRun[]

  @@unique([channelAccountId, externalConversationId])
  @@index([tenantId, status])
  @@map("conversation_refs")
  @@schema("channels")
}

model AiConfiguration {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  enabled               Boolean  @default(false)
  model                 String   @default("openai/gpt-4.1-mini")
  systemPrompt          String   @default("") @map("system_prompt") @db.Text
  humanHandoffThreshold Float    @default(0.75) @map("human_handoff_threshold")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_configurations")
  @@schema("ai")
}

model Agent {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  code         String
  name         String
  description  String?
  mode         String         @default("hybrid")
  provider     String         @default("openrouter")
  model        String         @default("openai/gpt-4.1-mini")
  systemPrompt String         @default("") @map("system_prompt") @db.Text
  temperature  Decimal?
  enabled      Boolean        @default(true)
  config       Json           @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions     AgentVersion[]
  bindings     AgentBinding[]
  flowRuns     FlowRun[]
  relationshipStates RelationshipState[]
  memories     ConversationMemory[]
  conversationSummaries ConversationSummary[]
  openLoops    OpenLoop[]
  worldStates  AgentWorldState[]
  agentRuns    AgentRun[]
  followups    AgentFollowup[]

  @@unique([tenantId, code])
  @@map("agents")
  @@schema("ai")
}

model AgentVersion {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  version   Int
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@map("agent_versions")
  @@schema("ai")
}

model AgentBinding {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  agentId          String          @map("agent_id") @db.Uuid
  channelAccountId String?         @map("channel_account_id") @db.Uuid
  flowId           String?         @map("flow_id") @db.Uuid
  priority         Int             @default(100)
  enabled          Boolean         @default(true)
  conditions       Json            @default("{}")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent            Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  flow             FlowDefinition? @relation(fields: [flowId], references: [id], onDelete: SetNull)

  @@unique([agentId, channelAccountId, flowId])
  @@map("agent_bindings")
  @@schema("ai")
}

model ContactIdentity {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  contactId        String          @map("contact_id") @db.Uuid
  channelAccountId String?         @map("channel_account_id") @db.Uuid
  identityType     String          @map("identity_type")
  identityValue    String          @map("identity_value")
  verifiedLink     Boolean         @default(false) @map("verified_link")
  metadata         Json            @default("{}")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, identityType, identityValue, channelAccountId])
  @@index([tenantId, identityType, identityValue])
  @@index([contactId])
  @@index([channelAccountId])
  @@map("contact_identities")
  @@schema("channels")
}

model RelationshipState {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  contactId          String    @map("contact_id") @db.Uuid
  agentId            String    @map("agent_id") @db.Uuid
  stage              String    @default("new")
  familiarity        Int       @default(0)
  trust              Int       @default(0)
  emotionalCloseness Int       @default(0) @map("emotional_closeness")
  flirtIntensity     Int       @default(0) @map("flirt_intensity")
  reciprocity        Int       @default(0)
  engagement         Int       @default(0)
  purchaseReadiness  Int       @default(0) @map("purchase_readiness")
  relationshipDepth  Int       @default(0) @map("relationship_depth")
  lastMood           String?   @map("last_mood")
  lastTopic          String?   @map("last_topic")
  lastInteractionAt  DateTime? @map("last_interaction_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent              Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([contactId, agentId])
  @@index([tenantId, stage, updatedAt(sort: Desc)])
  @@index([agentId])
  @@map("relationship_states")
  @@schema("ai")
}

model ConversationMemory {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  contactId       String    @map("contact_id") @db.Uuid
  agentId         String    @map("agent_id") @db.Uuid
  category        String
  fact            String    @db.Text
  confidence      Float     @default(0.8)
  sourceMessageId String?   @map("source_message_id")
  importance      Int       @default(50)
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastConfirmedAt DateTime  @default(now()) @map("last_confirmed_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  status          String    @default("active")
  metadata        Json      @default("{}")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, agentId, status])
  @@index([contactId, agentId, importance(sort: Desc)])
  @@index([agentId])
  @@map("conversation_memories")
  @@schema("ai")
}

model ConversationSummary {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  conversationRefId String          @map("conversation_ref_id") @db.Uuid
  contactId         String          @map("contact_id") @db.Uuid
  agentId           String          @map("agent_id") @db.Uuid
  rollingSummary    String          @map("rolling_summary") @db.Text
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationRef   ConversationRef @relation(fields: [conversationRefId], references: [id], onDelete: Cascade)
  contact           Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent             Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([conversationRefId, agentId])
  @@index([contactId, agentId])
  @@index([agentId])
  @@index([tenantId])
  @@map("conversation_summaries")
  @@schema("ai")
}

model OpenLoop {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  contactId  String    @map("contact_id") @db.Uuid
  agentId    String    @map("agent_id") @db.Uuid
  topic      String    @db.Text
  status     String    @default("open")
  dueAfter   DateTime? @map("due_after") @db.Timestamptz(6)
  priority   Int       @default(50)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, agentId, status])
  @@index([contactId])
  @@index([agentId])
  @@map("open_loops")
  @@schema("ai")
}

model AgentWorldState {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  agentId           String    @map("agent_id") @db.Uuid
  validFrom         DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime? @map("valid_until") @db.Timestamptz(6)
  timezone          String
  availability      String    @default("medium")
  mood              String?
  currentContext    String?   @map("current_context")
  todayStory        String?   @map("today_story") @db.Text
  conversationHooks Json      @default("[]") @map("conversation_hooks")
  canonVersion      Int?      @map("canon_version")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, validFrom(sort: Desc)])
  @@index([tenantId])
  @@map("world_states")
  @@schema("ai")
}

model AgentRun {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  eventId           String?          @map("event_id")
  contactId         String           @map("contact_id") @db.Uuid
  agentId           String           @map("agent_id") @db.Uuid
  conversationRefId String?          @map("conversation_ref_id") @db.Uuid
  plannerVersion    String           @default("relationship-planner-v1") @map("planner_version")
  promptVersion     String           @default("relationship-writer-v1") @map("prompt_version")
  model             String
  decision          Json             @default("{}")
  responseEnvelope  Json?            @map("response_envelope")
  latencyMs         Int?             @map("latency_ms")
  result            String           @default("completed")
  errorMessage      String?          @map("error_message") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent             Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationRef   ConversationRef? @relation(fields: [conversationRefId], references: [id], onDelete: SetNull)

  @@unique([tenantId, eventId])
  @@index([tenantId, contactId, agentId, createdAt(sort: Desc)])
  @@index([contactId])
  @@index([agentId])
  @@index([conversationRefId])
  @@map("agent_runs")
  @@schema("ai")
}

model AgentFollowup {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  contactId       String    @map("contact_id") @db.Uuid
  agentId         String    @map("agent_id") @db.Uuid
  reason          String
  earliestAt      DateTime  @map("earliest_at") @db.Timestamptz(6)
  latestAt        DateTime? @map("latest_at") @db.Timestamptz(6)
  status          String    @default("scheduled")
  messageStrategy Json      @default("{}") @map("message_strategy")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, earliestAt])
  @@index([contactId, agentId])
  @@index([agentId])
  @@map("followups")
  @@schema("ai")
}

model FlowDefinition {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  code               String
  name               String
  engine             String         @default("native")
  conversationalMode String         @default("closed") @map("conversational_mode")
  externalId         String?        @map("external_id")
  status             String         @default("draft")
  definition         Json           @default("{}")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs               FlowRun[]
  agentBindings      AgentBinding[]

  @@unique([tenantId, code])
  @@map("definitions")
  @@schema("flows")
}

model FlowRun {
