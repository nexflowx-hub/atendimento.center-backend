generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

enum TenantPlan {
  internal
  starter
  business
  enterprise
}

enum UserRole {
  owner
  admin
  supervisor
  agent
  viewer
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  status              TenantStatus         @default(trial)
  plan                TenantPlan           @default(starter)
  locale              String               @default("pt-BR")
  timezone            String               @default("America/Sao_Paulo")
  chatwootAccountId   Int?                 @unique
  evolutionInstance   String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               TenantUser[]
  aiConfiguration     AiConfiguration?
  appointmentRequests AppointmentRequest[]
  auditLogs           AuditLog[]
}

model TenantUser {
  id         String   @id @default(uuid())
  tenantId   String
  authUserId String
  role       UserRole @default(agent)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, authUserId])
  @@index([authUserId])
}

model AiConfiguration {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  enabled              Boolean  @default(false)
  model                 String   @default("openai/gpt-4.1-mini")
  systemPrompt          String   @db.Text
  humanHandoffThreshold Float    @default(0.75)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AppointmentRequest {
  id              String   @id @default(uuid())
  tenantId        String
  contactName     String?
  contactPhone    String
  service         String?
  preferredDate   DateTime?
  preferredPeriod String?
  status          String   @default("pending")
  conversationId  String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}


enum AgentStatus {
  active
  inactive
  archived
}

enum AgentChannel {
  web
  whatsapp
  instagram
  facebook
  api
}

enum AgentConversationStatus {
  active
  cancelled
  handed_off
  closed
}

enum HandoffState {
  none
  required
  active
  resolved
}

enum AgentMessageRole {
  system
  user
  assistant
  tool
}

enum AgentMessageStatus {
  pending
  streaming
  completed
  failed
  cancelled
}

enum AgentRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum ToolCallStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum ToolHttpMethod {
  GET
  POST
}

enum MemoryCandidateStatus {
  pending
  accepted
  rejected
}

enum OperationalMemoryStatus {
  active
  superseded
  revoked
}

model Agent {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  description String?     @db.Text
  status      AgentStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  versions    AgentVersion[]
  conversations AgentConversation[]
}

model AgentVersion {
  id            String   @id @default(uuid())
  agentId       String
  version       Int
  label         String?
  provider      String   @default("openrouter")
  model         String   @default("openai/gpt-4.1-mini")
  temperature   Float    @default(0.2)
  systemPrompt  String   @db.Text
  skills        Json?
  safetyPolicy  Json?
  memoryPolicy  Json?
  channelPolicy Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tools         AgentVersionTool[]
  conversations AgentConversation[]
  runs          AgentRun[]

  @@unique([agentId, version])
  @@index([agentId, active])
}

model ToolRegistry {
  id           String         @id @default(uuid())
  key          String         @unique
  description  String         @db.Text
  method       ToolHttpMethod @default(GET)
  endpointPath String
  scopes       Json
  inputSchema  Json?
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  versions     AgentVersionTool[]
}

model AgentVersionTool {
  agentVersionId String
  toolId         String
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  tool           ToolRegistry @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([agentVersionId, toolId])
}

model AgentConversation {
  id             String                  @id @default(uuid())
  productKey     String                  @default("mytrainx")
  userId         String
  agentId        String
  agentVersionId String
  channel        AgentChannel            @default(web)
  title          String?
  status         AgentConversationStatus @default(active)
  handoffState   HandoffState            @default(none)
  threadContext  Json?
  summary        String?                 @db.Text
  lastMessageAt  DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  agent          Agent                   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  agentVersion   AgentVersion            @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  messages       AgentMessage[]
  runs           AgentRun[]
  memoryCandidates MemoryCandidate[]

  @@index([productKey, userId, agentId, updatedAt])
  @@index([userId, status])
}

model AgentMessage {
  id             String             @id @default(uuid())
  conversationId String
  role           AgentMessageRole
  content        String             @db.Text
  status         AgentMessageStatus @default(completed)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  conversation   AgentConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentRun {
  id                 String         @id @default(uuid())
  conversationId     String
  agentVersionId     String
  requestId          String         @unique
  userMessageId      String?
  assistantMessageId String?
  status             AgentRunStatus @default(queued)
  provider           String
  model              String
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  estimatedCostUsd   Decimal?       @db.Decimal(18, 8)
  latencyMs          Int?
  errorCode          String?
  errorMessage       String?        @db.Text
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  conversation       AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentVersion       AgentVersion      @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  toolCalls          AgentToolCall[]

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model AgentToolCall {
  id          String         @id @default(uuid())
  runId       String
  toolKey     String
  requestId   String
  status      ToolCallStatus @default(pending)
  input       Json
  output      Json?
  errorCode   String?
  errorMessage String?       @db.Text
  durationMs  Int?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  run         AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
  @@index([toolKey, startedAt])
}

model MemoryCandidate {
  id              String                @id @default(uuid())
  productKey      String                @default("mytrainx")
  userId          String
  conversationId  String
  sourceMessageId String?
  key             String
  value           Json
  reason          String?               @db.Text
  confidence      Float                 @default(0.5)
  status          MemoryCandidateStatus @default(pending)
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())
  conversation    AgentConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([productKey, userId, status, createdAt])
}

model OperationalMemory {
  id          String                  @id @default(uuid())
  productKey  String                  @default("mytrainx")
  userId      String
  agentKey    String?
  key         String
  value       Json
  source      String
  confidence  Float                   @default(1)
  status      OperationalMemoryStatus @default(active)
  expiresAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([productKey, userId, status])
  @@index([agentKey, userId])
}

model ChannelIdentityLink {
  id                 String       @id @default(uuid())
  productKey         String       @default("mytrainx")
  userId             String
  channel            AgentChannel
  externalIdentifier String
  verified           Boolean      @default(false)
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([productKey, channel, externalIdentifier])
  @@index([productKey, userId])
}


model AgentGatewayReplay {
  id        String   @id @default(uuid())
  requestId String   @unique
  service   String
  userId    String
  method    String
  pathname  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([service, userId, createdAt])
}
