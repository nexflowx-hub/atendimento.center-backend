# TLS / Caddy
ACME_EMAIL=ops@atlasglobal.digital
EVOLUTION_BASIC_AUTH_HASH=

# Pinned application versions
CHATWOOT_VERSION=v4.16.0-ce
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false

# Local execution infrastructure (Chatwoot + Evolution + Redis)
# Atlas business state lives in the Supabase Atlas Platform Core.
LOCAL_POSTGRES_USER=atendimento
LOCAL_POSTGRES_PASSWORD=
REDIS_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=
EVOLUTION_API_KEY=

# Atlas Platform Core + Auth
# SUPABASE_ANON_KEY may contain either the legacy anon key or the current publishable key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# PostgreSQL connection used by the NestJS/Prisma control plane.
# Prefer the Supabase session pooler for the persistent backend.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Filled after creating the Chatwoot admin/API token
CHATWOOT_API_TOKEN=

# Meta social channels for self-hosted Chatwoot
# Facebook Messenger works with Facebook Pages, not personal/private profiles.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=

# Preferred Instagram Business Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Legacy/compat Instagram webhook verify token used by some Chatwoot flows
IG_VERIFY_TOKEN=

# AI provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Atlas Growth / SMM checkout
XPAYMENTS_BASE_URL=https://api.xpayments.digital/api/v1
XPAYMENTS_API_KEY=
XPAYMENTS_WEBHOOK_SECRET=

# Atlas execution workers
ATLAS_WORKER_INTERVAL_MS=5000
ATLAS_SIGNALS_WORKER_INTERVAL_MS=5000
ATLAS_AGENT_WORKER_CONCURRENCY=1

# Atlas Growth / SMM provider API keys
# Provider base URLs are configured in smm.providers; secrets stay in runtime env.
SMM_JAP_API_KEY=
SMM_PEAKERR_API_KEY=
SMM_SMMFOLLOWS_API_KEY=
SMM_REVENDA_EXCLUSIVA_API_KEY=

# Atlas Signals connectors
APIFY_TOKEN=
BRIGHT_DATA_API_TOKEN=

# Optional SMTP
MAILER_SENDER_EMAIL='Atendimento.Center <no-reply@atendimento.center>'
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
