# TLS / Caddy
ACME_EMAIL=ops@atlasglobal.digital
EVOLUTION_BASIC_AUTH_HASH=

# Pinned application versions
CHATWOOT_VERSION=v4.16.0-ce
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false

# Local infrastructure (Core + Chatwoot + Evolution)
LOCAL_POSTGRES_USER=atendimento
LOCAL_POSTGRES_PASSWORD=
REDIS_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=
EVOLUTION_API_KEY=

# Supabase is used for Atendimento.Center authentication only.
# SUPABASE_ANON_KEY may contain either the legacy anon key or the current publishable key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Filled after creating the Chatwoot admin/API token
CHATWOOT_API_TOKEN=

# AI provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional SMTP
MAILER_SENDER_EMAIL='Atendimento.Center <no-reply@atendimento.center>'
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
