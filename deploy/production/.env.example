# TLS / Caddy
ACME_EMAIL=ops@atlasglobal.digital
EVOLUTION_BASIC_AUTH_HASH=

# Pinned application versions
CHATWOOT_VERSION=v4.16.0-ce
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false

# Local infrastructure (Core + Chatwoot + Evolution)
LOCAL_POSTGRES_USER=atendimento
LOCAL_POSTGRES_PASSWORD=
REDIS_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=
EVOLUTION_API_KEY=

# Supabase is used for Atendimento.Center authentication only.
# SUPABASE_ANON_KEY may contain either the legacy anon key or the current publishable key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Filled after creating the Chatwoot admin/API token
CHATWOOT_API_TOKEN=

# Meta social channels for self-hosted Chatwoot
# Facebook Messenger works with Facebook Pages, not personal/private profiles.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=

# Preferred Instagram Business Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Legacy/compat Instagram webhook verify token used by some Chatwoot flows
IG_VERIFY_TOKEN=

# AI provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# MyTrainX <-> Atendimento.Center Agent Core B1
MYTRAINX_BASE_URL=https://mytrainx.fit
MYTRAINX_AGENT_SHARED_SECRET=
MYTRAINX_AGENT_SERVICE=atendimento-center
MYTRAINX_AGENT_GATEWAY_ALLOWED_SERVICE=mytrainx
MYTRAINX_AGENT_GATEWAY_SCOPE=agent:access
MYTRAINX_AGENT_GATEWAY_MAX_SKEW_SECONDS=90
MYTRAINX_TOOL_TIMEOUT_MS=12000

# Optional SMTP
MAILER_SENDER_EMAIL='Atendimento.Center <no-reply@atendimento.center>'
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
